#!/usr/bin/env bash
set -euo pipefail

model="${QWEN36_MODEL:-$HOME/models/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-IQ4_NL.gguf}"
host="${QWEN36_HOST:-127.0.0.1}"
port="${QWEN36_PORT:-8080}"
ctx="${QWEN36_CTX:-16384}"
gpu_layers="${QWEN36_GPU_LAYERS:-auto}"
threads="${QWEN36_THREADS:-10}"

exec llama-server \
  --model "$model" \
  --host "$host" \
  --port "$port" \
  --ctx-size "$ctx" \
  --gpu-layers "$gpu_layers" \
  --threads "$threads" \
  --flash-attn on \
  --jinja \
  --reasoning "${QWEN36_REASONING:-off}" \
  "$@"
